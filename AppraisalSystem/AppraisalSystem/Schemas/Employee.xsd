<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Employee" xmlns:tns="http://www.example.org/Employee" elementFormDefault="qualified">

    <element name="empdetails" type="tns:empdetailstype"></element>

    <element name="empid" type="integer"></element>

    <element name="empname" type="string"></element>

    <element name="salary" type="decimal"></element>

    <complexType name="empdetailstype">
    	<sequence>
    		<element ref="tns:empid"></element>
    		<element ref="tns:empname"></element>
    		<element ref="tns:salary"></element>
    		<element ref="tns:projectdetails" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="projectdetailstype">
    	<sequence>
    		<element ref="tns:projectid"></element>
    		<element ref="tns:projectname"></element>
    		<element ref="tns:profitearned"></element>
    	</sequence>
    </complexType>

    <element name="projectname" type="string"></element>

    <element name="projectid" type="integer"></element>

    <element name="profitearned" type="decimal"></element>

    <element name="projectdetails" type="tns:projectdetailstype"></element>

    <complexType name="StaffType">
    	<sequence>
    		<element ref="tns:empdetails"></element>
    	</sequence>
    </complexType>
    
    <element name="Staff" type="tns:StaffType"></element>
</schema>