            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:Resource"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.example.org/Employee/REST/1738592755865"/>
        </wsdl:definitions>
