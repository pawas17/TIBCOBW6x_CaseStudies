<bpws:process exitOnStandardFault="no" name="restwebservice.Process"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20250203193447"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
